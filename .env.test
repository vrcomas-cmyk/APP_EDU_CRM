# Entorno fijo para la suite de pruebas (vitest), sin importar en qué rama se ejecute.
#
# Sin este archivo, vitest carga el `.env` de la rama actual — y en `pruebas` eso pone
# VITE_ENTORNO=pruebas, lo que prefija las claves de localStorage (ver js/entorno.js) y rompe
# decenas de aserciones que asumen las claves sin prefijo ('sesion', 'visitas', etc.). La
# suite prueba el DOMINIO de la app, no en qué entorno corre, así que fija "produccion" (sin
# prefijo) y unos valores de Supabase válidos para el guardarraíl de config.ts — nunca se
# conecta de verdad: `fetch` está deshabilitado en tests/entorno.js.
VITE_ENTORNO=produccion
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyRdGq_Tef6GGg8MWr7_VNLS-VLvx439MTWPpmjJQ3kjXk_6OvtrFc19ehh7_GoVBZZ/exec
VITE_SUPABASE_URL=https://fiplfsuhsqibzrpvjvbx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZpcGxmc3Voc3FpYnpycHZqdmJ4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQyODAyNjgsImV4cCI6MjA4OTg1NjI2OH0.YG3Fk8XJ_n9PGIYUHtoiy-MJNuWqJTsFBwooKnt1X5s
VITE_TIMEOUT_MS=20000
